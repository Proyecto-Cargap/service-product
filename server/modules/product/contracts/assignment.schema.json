{
  "type"                 : "object",
  "properties"           : {
    "customerCode"  : {
      "type"      : "string",
      "minLength" : 1,
      "maxLength" : 100
    },
    "priceListCode" : {
      "type"      : "string",
      "minLength" : 1,
      "maxLength" : 100
    },
    "active"        : {
      "type" : "boolean"
    },
    "code"          : {
      "type"    : "string",
      "pattern" : "^[A-Z]{3}-[a-f0-9-]{36}$"
    },
    "workspace"     : {
      "type"      : "string",
      "minLength" : 1,
      "maxLength" : 100
    },
    "userCreate"    : {
      "type"      : "string",
      "minLength" : 1,
      "maxLength" : 100
    },
    "creationDate"  : {
      "type"    : "integer",
      "minimum" : 0
    },
    "updateDate"    : {
      "type"    : "integer",
      "minimum" : 0
    },
    "revision"      : {
      "type"    : "integer",
      "minimum" : 1
    }
  },
  "required"             : [
    "customerCode",
    "priceListCode",
    "active",
    "code",
    "workspace",
    "userCreate",
    "creationDate",
    "updateDate",
    "revision"
  ],
  "additionalProperties" : false
