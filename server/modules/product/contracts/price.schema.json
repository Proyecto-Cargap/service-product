{
  "type"                 : "object",
  "properties"           : {
    "priceListCode" : {
      "type"      : "string",
      "minLength" : 1,
      "maxLength" : 100
    },
    "skuCode"       : {
      "type"      : "string",
      "minLength" : 1,
      "maxLength" : 100
    },
    "unitPrice"     : {
      "type"      : "string",
      "maxLength" : 30,
      "pattern"   : "^(0|[1-9]\\d{0,14})(\\.\\d{1,6})?$"
    },
    "active"        : {
      "type" : "boolean"
    },
    "code"          : {
      "type"    : "string",
      "pattern" : "^[A-Z]{3}-[a-f0-9-]{36}$"
    },
    "workspace"     : {
      "type"      : "string",
      "minLength" : 1,
      "maxLength" : 100
    },
    "userCreate"    : {
      "type"      : "string",
      "minLength" : 1,
      "maxLength" : 100
    },
    "creationDate"  : {
      "type"    : "integer",
      "minimum" : 0
    },
    "updateDate"    : {
      "type"    : "integer",
      "minimum" : 0
    },
    "revision"      : {
      "type"    : "integer",
      "minimum" : 1
    },
    "erased"        : {
      "type" : "boolean"
    }
  },
  "required"             : [
    "priceListCode",
    "skuCode",
    "unitPrice",
    "active",
    "code",
    "workspace",
    "userCreate",
    "creationDate",
    "updateDate",
    "revision",
    "erased"
  ],
  "additionalProperties" : false
}
