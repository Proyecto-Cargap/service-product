    "image"        : {
      "type"                 : "object",
      "properties"           : {
        "fileId"   : {
          "type"      : "string",
          "minLength" : 1,
          "maxLength" : 100
        },
        "name"     : {
          "type"      : "string",
          "minLength" : 0,
          "maxLength" : 300
        },
        "mimeType" : {
          "type"      : "string",
          "minLength" : 0,
          "maxLength" : 100
        },
        "size"     : {
          "type"    : "integer",
          "minimum" : 0
        }
      },
      "required"             : ["fileId", "name", "mimeType", "size"],
      "additionalProperties" : false
    },
    "images"       : {
      "type"     : "array",
