        "additionalProperties" : false
      },
      "maxItems" : 8
    },
    "active"       : {
      "type" : "boolean"
    },
    "code"         : {
      "type"    : "string",
      "pattern" : "^[A-Z]{3}-[a-f0-9-]{36}$"
    },
    "workspace"    : {
      "type"      : "string",
      "minLength" : 1,
      "maxLength" : 100
