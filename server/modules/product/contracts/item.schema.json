{
  "type"                 : "object",
  "properties"           : {
    "name"            : {
      "type"      : "string",
      "minLength" : 1,
      "maxLength" : 150
    },
    "description"     : {
      "type"      : "string",
      "minLength" : 0,
      "maxLength" : 1000
    },
    "type"            : {
      "type" : "string",
      "enum" : ["product", "service"]
    },
    "mode"            : {
      "type" : "string",
      "enum" : ["simple", "variants"]
    },
    "sku"             : {
      "type"      : "string",
      "minLength" : 0,
      "maxLength" : 100
    },
    "categoryCode"    : {
      "type"      : "string",
      "minLength" : 0,
      "maxLength" : 100
    },
    "attributeCodes"  : {
      "type"     : "array",
      "items"    : {
        "type"      : "string",
        "minLength" : 1,
        "maxLength" : 100
      },
      "maxItems" : 8
    },
    "fiscal"          : {
      "type"                 : "object",
      "properties"           : {
        "productService" : {
          "type"      : "string",
          "maxLength" : 8
        },
        "unit"           : {
          "type"      : "string",
          "maxLength" : 10
        },
        "unitName"       : {
          "type"      : "string",
          "maxLength" : 100
        },
        "taxObject"      : {
          "type"      : "string",
          "maxLength" : 2
        },
        "taxes"          : {
          "type"     : "array",
          "items"    : {
            "type"                 : "object",
            "properties"           : {
              "kind"   : {
                "type" : "string",
                "enum" : ["transferred", "withheld"]
              },
              "code"   : {
                "type" : "string",
                "enum" : ["001", "002", "003"]
              },
              "factor" : {
                "type" : "string",
                "enum" : ["Tasa", "Cuota", "Exento"]
              },
              "rate"   : {
                "type"      : "string",
                "maxLength" : 30,
                "pattern"   : "^(0|[1-9]\\d{0,14})(\\.\\d{1,6})?$"
              }
            },
            "required"             : ["kind", "code", "factor"],
            "additionalProperties" : false
          },
          "maxItems" : 12
        }
      },
      "required"             : [],
      "additionalProperties" : false
    },
    "active"          : {
      "type" : "boolean"
    },
    "code"            : {
      "type"    : "string",
      "pattern" : "^[A-Z]{3}-[a-f0-9-]{36}$"
    },
    "workspace"       : {
      "type"      : "string",
      "minLength" : 1,
      "maxLength" : 100
    },
    "userCreate"      : {
      "type"      : "string",
      "minLength" : 1,
      "maxLength" : 100
    },
    "creationDate"    : {
      "type"    : "integer",
      "minimum" : 0
    },
    "updateDate"      : {
      "type"    : "integer",
      "minimum" : 0
    },
    "revision"        : {
      "type"    : "integer",
      "minimum" : 1
    },
    "image"           : {
      "type"                 : "object",
      "properties"           : {
        "fileId"   : {
          "type"      : "string",
          "minLength" : 1,
          "maxLength" : 100
        },
        "name"     : {
          "type"      : "string",
          "minLength" : 0,
          "maxLength" : 300
        },
        "mimeType" : {
          "type"      : "string",
          "minLength" : 0,
          "maxLength" : 100
        },
        "size"     : {
          "type"    : "integer",
          "minimum" : 0
        }
      },
      "required"             : ["fileId", "name", "mimeType", "size"],
      "additionalProperties" : false
    },
    "simpleSkuCode"   : {
      "type"      : "string",
      "minLength" : 1,
      "maxLength" : 100
    },
    "images"          : {
      "type"     : "array",
      "items"    : {
        "type"                 : "object",
        "properties"           : {
          "fileId"   : {
            "type"      : "string",
            "minLength" : 1,
            "maxLength" : 100
          },
          "name"     : {
            "type"      : "string",
            "minLength" : 0,
            "maxLength" : 300
          },
          "mimeType" : {
            "type"      : "string",
            "minLength" : 0,
            "maxLength" : 100
          },
          "size"     : {
            "type"    : "integer",
            "minimum" : 0
          }
        },
        "required"             : ["fileId", "name", "mimeType", "size"],
        "additionalProperties" : false
      },
      "maxItems" : 10
    },
    "descriptionHtml" : {
      "type"      : "string",
      "maxLength" : 16384
    }
  },
  "required"             : [
    "name",
    "description",
    "type",
    "mode",
    "sku",
    "categoryCode",
    "attributeCodes",
    "fiscal",
    "active",
    "code",
    "workspace",
    "userCreate",
    "creationDate",
    "updateDate",
    "revision"
  ],
  "additionalProperties" : false
}
